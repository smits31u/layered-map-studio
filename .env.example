# Browser (bundled into the client, so nothing secret belongs here)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
VITE_ORNAMENT_TILES_URL=https://tiles.openfreemap.org/planet

# Geocoder proxy (read by the server only, never bundled into the client)
# Nominatim's usage policy requires a contactable identifier in the outgoing User-Agent. Without
# this the server warns at startup and the header says the contact is not configured.
GEOCODER_CONTACT=you@example.com
# Point these at a self-hosted instance to avoid the public services and their rate limits.
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io
CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov
